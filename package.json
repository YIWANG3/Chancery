{
  "name": "chancery-claude",
  "version": "0.0.1",
  "private": true,
  "description": "Agent development platform: Postgres-backed tickets, a resident daemon, Claude / Codex / dsh executors",
  "author": "YI WANG",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:electron": "wait-on tcp:5181 out/main.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5181 electron .",
    "build": "node scripts/build-main.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint core main preload renderer scripts tests",
    "check": "npm run typecheck && npm test && npm run build",
    "build:native": "bash scripts/build-native.sh",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "clsx": "^2.1.1",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.23.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "^45.2.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "lucide-react": "^0.541.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  }
}
